{
  "version": 6,
  "configurePresets": [
    {
      "name": "gcc14-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/gcc14-debug",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++-14",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "gcc14-release",
      "inherits": "gcc14-debug",
      "binaryDir": "${sourceDir}/build/gcc14-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "gcc14-asan",
      "displayName": "GCC 14 Debug + AddressSanitizer + UndefinedBehaviorSanitizer (docs/study/sanitizers.md)",
      "inherits": "gcc14-debug",
      "binaryDir": "${sourceDir}/build/gcc14-asan",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize=shift,integer-divide-by-zero,unreachable,return,signed-integer-overflow,float-cast-overflow -fno-sanitize-recover=all -fno-omit-frame-pointer -D_GLIBCXX_ASSERTIONS"
      },
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:strict_string_checks=1:check_initialization_order=1:new_delete_type_mismatch=0"
      }
    },
    {
      "name": "gcc14-tsan",
      "displayName": "GCC 14 Debug + ThreadSanitizer (docs/study/sanitizers.md)",
      "inherits": "gcc14-debug",
      "binaryDir": "${sourceDir}/build/gcc14-tsan",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer -Wno-error=tsan"
      }
    },
    {
      "name": "clang19-debug",
      "displayName": "Clang 19 Debug with GCC 14's standard library (libstdc++)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/clang19-debug",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++-19",
        "CMAKE_CXX_COMPILER_CLANG_SCAN_DEPS": "clang-scan-deps-19",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "clang20-debug",
      "displayName": "Clang 20 Debug with GCC 14's standard library (libstdc++)",
      "inherits": "clang19-debug",
      "binaryDir": "${sourceDir}/build/clang20-debug",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++-20",
        "CMAKE_CXX_COMPILER_CLANG_SCAN_DEPS": "clang-scan-deps-20"
      }
    },
    {
      "name": "clang20-libcxx-debug",
      "displayName": "Clang 20 Debug with LLVM's standard library (libc++ 20), the one Emscripten uses",
      "inherits": "clang20-debug",
      "binaryDir": "${sourceDir}/build/clang20-libcxx-debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gcc14-debug",
      "configurePreset": "gcc14-debug"
    },
    {
      "name": "gcc14-release",
      "configurePreset": "gcc14-release"
    },
    {
      "name": "gcc14-asan",
      "configurePreset": "gcc14-asan"
    },
    {
      "name": "gcc14-tsan",
      "configurePreset": "gcc14-tsan"
    },
    {
      "name": "clang19-debug",
      "configurePreset": "clang19-debug"
    },
    {
      "name": "clang20-debug",
      "configurePreset": "clang20-debug"
    },
    {
      "name": "clang20-libcxx-debug",
      "configurePreset": "clang20-libcxx-debug"
    }
  ],
  "testPresets": [
    {
      "name": "gcc14-debug",
      "configurePreset": "gcc14-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc14-release",
      "configurePreset": "gcc14-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gcc14-asan",
      "configurePreset": "gcc14-asan",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 4,
        "timeout": 900
      },
      "filter": {
        "exclude": {
          "name": "seconds of CPU"
        }
      }
    },
    {
      "name": "gcc14-tsan",
      "configurePreset": "gcc14-tsan",
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1"
      },
      "filter": {
        "include": {
          "name": "workers ran|--jobs|--replications|run_replications"
        }
      },
      "execution": {
        "timeout": 300
      }
    },
    {
      "name": "clang19-debug",
      "configurePreset": "clang19-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang20-debug",
      "configurePreset": "clang20-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang20-libcxx-debug",
      "configurePreset": "clang20-libcxx-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
