{
  "name": "simsys-web",
  "private": true,
  "description": "system-sim's watch-only web app: the precomputed datasets, the page that plays them, and the contract between them.",
  "type": "module",
  "workspaces": [
    "stream",
    "precompute",
    "app"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run check:types && npm run check:lint && npm run check:format",
    "check:types": "tsc -p stream --noEmit && tsc -p precompute --noEmit && tsc -p app --noEmit",
    "check:lint": "eslint .",
    "check:format": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "build": "npm run build -w @simsys/app",
    "dev": "npm run dev -w @simsys/app",
    "serve": "npm run build && npm run preview -w @simsys/app",
    "precompute": "tsx precompute/src/main.ts",
    "fixtures": "tsx precompute/src/fixtures.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
